# Copy to .env and fill in. Only the first two keys are required.

# ── Model (required) ───────────────────────────────────────────────
# Any OpenAI-compatible API works. Default is OpenAI.
OPENAI_API_KEY=
# Main chat model and the cheap model used for background memory extraction.
CHAT_MODEL=gpt-5.4-mini
FAST_MODEL=gpt-5.4-nano
# Optional: none | minimal | low | medium | high (reasoning models only). Unset = provider default (fastest).
REASONING_EFFORT=

# Free alternatives: set OPENAI_BASE_URL plus that provider's key in OPENAI_API_KEY.
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1                      CHAT_MODEL=llama-3.3-70b-versatile  FAST_MODEL=llama-3.1-8b-instant
#   Gemini:     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  CHAT_MODEL=gemini-2.5-flash  FAST_MODEL=gemini-2.5-flash-lite
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1                         CHAT_MODEL=<any model with tool calling>
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama     CHAT_MODEL=qwen3:14b
OPENAI_BASE_URL=

# ── Web search (optional with an OpenAI key) ───────────────────────
# Tried in this order; the next one takes over if a provider fails.
# "openai" = OpenAI's hosted web search: needs no extra key, but is slower and costs more per query.
SEARCH_PROVIDERS=tavily,brave,serper,openai
# https://tavily.com  (free tier: 1,000 searches/month, recommended)
TAVILY_API_KEY=
# https://brave.com/search/api
BRAVE_API_KEY=
# https://serper.dev  (free tier: 2,500 searches)
SERPER_API_KEY=

# ── Database (optional) ────────────────────────────────────────────
# Leave empty for zero setup: `npm run dev` starts an embedded MongoDB stored in ./.data/mongo.
# For real use, point this at MongoDB Atlas or any MongoDB 6+.
MONGODB_URI=

# ── Optional ───────────────────────────────────────────────────────
PORT=8787
LOG_LEVEL=info
# Pretend it's a different moment (ISO 8601), to test date-relative memory. Example: 2026-11-10T18:30:00+05:30
AGENT_NOW=

# ── Usage limits (protect your API key) ────────────────────────────
# Longest question accepted, in words.
MAX_INPUT_WORDS=300
# Longest answer, in tokens (~0.75 words each).
MAX_ANSWER_TOKENS=1200
# Messages per person per rolling 24 hours.
DAILY_MESSAGE_LIMIT=60
# Search queries the agent may run per step (1-6). OpenAI web search bills per query.
MAX_SEARCH_QUERIES=4

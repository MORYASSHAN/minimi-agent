# Copy this file to .env and fill it in. Only OPENAI_API_KEY is required.

# Model
# Any OpenAI-compatible API works; OpenAI is the default.
OPENAI_API_KEY=
# Main chat model, and a cheaper one for background memory extraction.
CHAT_MODEL=gpt-5.4-mini
FAST_MODEL=gpt-5.4-nano
# none | minimal | low | medium | high (reasoning models only). Leave empty for the provider default.
REASONING_EFFORT=
# To use another provider, set its URL here and its key in OPENAI_API_KEY, e.g.
#   Groq        https://api.groq.com/openai/v1                             CHAT_MODEL=llama-3.3-70b-versatile
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/   CHAT_MODEL=gemini-2.5-flash
#   OpenRouter  https://openrouter.ai/api/v1                               CHAT_MODEL=any model with tool calling
#   Ollama      http://localhost:11434/v1  (OPENAI_API_KEY=ollama)         CHAT_MODEL=qwen3:14b
OPENAI_BASE_URL=

# Web search
# Providers are tried in this order. "openai" is OpenAI's hosted search: no extra key,
# but slower and pricier per query, so a Tavily key is recommended.
SEARCH_PROVIDERS=tavily,brave,serper,openai
# https://tavily.com (free tier: 1,000 searches a month)
TAVILY_API_KEY=
# https://brave.com/search/api
BRAVE_API_KEY=
# https://serper.dev (free tier: 2,500 searches)
SERPER_API_KEY=

# Database
# Leave empty and `npm run dev` runs a local MongoDB with its data in ./.data/mongo.
# Otherwise point it at MongoDB Atlas or any MongoDB 6+.
MONGODB_URI=

# Usage limits
MAX_INPUT_WORDS=300
MAX_ANSWER_TOKENS=1200
# Messages per person in a rolling 24 hours.
DAILY_MESSAGE_LIMIT=100
# Search queries per step, 1 to 6. Each OpenAI web search is billed separately.
MAX_SEARCH_QUERIES=4

# Other
PORT=8787
LOG_LEVEL=info
# Run as if it were another moment (ISO 8601), for testing date-based memory.
# Example: 2026-11-03T14:00:00+05:30
AGENT_NOW=
